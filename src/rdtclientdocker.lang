# ===========================================================================
# Multilingual file for the TOS 7 Docker application "rdtclientdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "rdt-client"
auth         = "rogerfar"
version      = "@@VERSION@@"
descript     = "rdt-client is a web interface that manages torrent and usenet downloads through a debrid account (Real-Debrid, AllDebrid, Premiumize, TorBox, DebridLink or HIGHWAY): add magnets, torrents or NZB files, let the debrid service fetch them and download the files to this NAS, unpacking archives automatically. It also emulates the qBittorrent API so Sonarr, Radarr or Couchpotato can use it. This package runs the official Docker Hub image as a non-root container with its data in the application data folder."
release_note = "Review remediation: PRIVACY.md, NOTICE.md and the README privacy / third-party / licence sections added; the help field now opens the privacy policy; the author and both Chinese descriptions were corrected (the image is rogerfar/rdtclient, not LinuxServer.io, and the app is a debrid download manager rather than a BitTorrent client); upstream upgraded to 2.0.143."
important    = "A premium debrid account is required: add your provider and its API token in Settings after the first start. Downloads land in /Volume1/DockerAppData/rdtclientdocker/data/downloads - keep the download path below that folder so the files survive restarts and updates. The container runs as uid 1000. Needs DockerEngine; configure a registry mirror if Docker Hub is unreachable. Back up the data folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "rdt-client"
auth         = "rogerfar"
version      = "@@VERSION@@"
descript     = "rdt-client 是一个通过网盘（Real-Debrid、AllDebrid、Premiumize、TorBox、DebridLink 或 HIGHWAY）托管种子与 usenet 下载的网页工具：添加磁力、种子或 NZB 后由网盘取回文件并下载到本机，自动解压；同时提供 qBittorrent 兼容 API，可接入 Sonarr / Radarr / Couchpotato。本应用直接运行 Docker Hub 官方镜像（非 root），数据保存在应用数据目录。"
release_note = "Review remediation: PRIVACY.md, NOTICE.md and the README privacy / third-party / licence sections added; the help field now opens the privacy policy; the author and both Chinese descriptions were corrected (the image is rogerfar/rdtclient, not LinuxServer.io, and the app is a debrid download manager rather than a BitTorrent client); upstream upgraded to 2.0.143."
important    = "需要付费的网盘账号：首次打开后在设置里填入服务商与 API 令牌。下载文件落在 DockerAppData/rdtclientdocker/data/downloads——下载路径请保持在该目录下，否则重启和升级后不保留。容器以 uid 1000 运行。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

[zh-hk]
name         = "rdt-client"
auth         = "rogerfar"
version      = "@@VERSION@@"
descript     = "rdt-client 是一個透過網盤（Real-Debrid、AllDebrid、Premiumize、TorBox、DebridLink 或 HIGHWAY）託管種子與 usenet 下載的網頁工具：加入磁力、種子或 NZB 後由網盤取回檔案並下載到本機，自動解壓；同時提供 qBittorrent 相容 API，可接入 Sonarr / Radarr / Couchpotato。本應用直接執行 Docker Hub 官方映像（非 root），資料保存在應用資料目錄。"
release_note = "Review remediation: PRIVACY.md, NOTICE.md and the README privacy / third-party / licence sections added; the help field now opens the privacy policy; the author and both Chinese descriptions were corrected (the image is rogerfar/rdtclient, not LinuxServer.io, and the app is a debrid download manager rather than a BitTorrent client); upstream upgraded to 2.0.143."
important    = "需要付費的網盤帳號：首次開啟後在設定裡填入服務商與 API 權杖。下載檔案落在 DockerAppData/rdtclientdocker/data/downloads——下載路徑請保持在該目錄下，否則重新啟動和升級後不保留。容器以 uid 1000 運行。需要 DockerEngine；Docker Hub 不可達時先設定鏡像加速。解除安裝並刪除資料前請備份。區域網路內為 HTTP。"

